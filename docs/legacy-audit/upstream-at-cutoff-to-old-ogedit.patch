-const ASCII_WHITESPACE_CHARSET: Charset = {
-    let mut charset = Charset::no();
-    charset.set(b' ', true);
-    charset.set(b'\t', true);
-    charset.set(b'\n', true);
-    charset.set(b'\r', true);
-    charset.set(0x0B, true); // vertical tab
-    charset.set(0x0C, true); // form feed
