+      - name: Create release
+        uses: softprops/action-gh-release@v1
+        with:
+          name: v${{ steps.get_version.outputs.VERSION }}
+          body: ${{ steps.release_notes.outputs.NOTES }}
+          draft: false
+          prerelease: ${{ steps.check_prerelease.outputs.IS_PRERELEASE }}
+          files: |
+            ogedit-*.zip
+            ogedit-*.zip.sha256
+            ogedit-*.msi
+            ogedit-*.msi.sha256
+            ogedit-*.pkg
+            ogedit-*.pkg.sha256
+            ogedit-*.tar.gz
+            ogedit-*.tar.gz.sha256
