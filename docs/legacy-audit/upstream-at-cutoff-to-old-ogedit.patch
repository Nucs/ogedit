+            return "";
+        };
+
+        let status = icu_ffi::UErrorCode::new(code);
+        let ptr = unsafe { (f.u_errorName)(status) };
+        if ptr.is_null() {
+            return "";
+        }
+
+        let str = unsafe { CStr::from_ptr(ptr) };
+        str.to_str().unwrap_or("")
+    }
+
+    let msg = format(code);
+    if !msg.is_empty() {
+        write!(f, "ICU Error: {msg}")
+    } else {
+        write!(f, "ICU Error: {code:#08x}")
+    }
