-        let new_cap = (cap * 2).max(self.len + add).max(min);
-        let new_ptr = unsafe {
-            alloc.realloc(
-                self.ptr.cast(),
-                self.cap * size_of::<T>(),
-                new_cap * size_of::<T>(),
-                align_of::<T>(),
-            )
