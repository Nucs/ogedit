-                    let d = self.registers.get(dst);
-                    let s = self.registers.get(src);
-                    self.registers.set(dst, d.saturating_add(s));
-                }
-                Sub { dst, src } => {
-                    let d = self.registers.get(dst);
-                    let s = self.registers.get(src);
-                    self.registers.set(dst, d.saturating_sub(s));
-                }
-                MovImm { dst, imm } => {
