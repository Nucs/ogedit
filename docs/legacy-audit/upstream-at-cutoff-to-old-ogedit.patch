+        k if k == vk::NEXT => "PageDown",
+        k if k == vk::LEFT => "Left",
+        k if k == vk::RIGHT => "Right",
+        k if k == vk::UP => "Up",
+        k if k == vk::DOWN => "Down",
+        _ => {
+            return "Unknown".to_string();
+        }
+    };
+
+    shortcut_str.to_string()
+}
