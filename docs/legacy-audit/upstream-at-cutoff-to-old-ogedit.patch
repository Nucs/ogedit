-    if text.is_empty() {
-        return MaybeOwned::Borrowed("");
-    }
-
-    let mut sanitized =
-        SanitizedControlChars { text: BString::empty(), unsane_ranges: BVec::empty() };
-    let mut chars = Utf8Chars::new(text, 0);
