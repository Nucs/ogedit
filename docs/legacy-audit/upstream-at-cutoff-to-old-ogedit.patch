-            Instruction::Mov { dst, src }
-            | Instruction::Add { dst, src }
-            | Instruction::Sub { dst, src } => {
-                buf.enc_reg_pair(dst, src);
-            }
-            Instruction::MovImm { dst, imm }
-            | Instruction::AddImm { dst, imm }
-            | Instruction::SubImm { dst, imm } => {
