-/// The bytecode interpreter for syntax highlighting.
-#[derive(Clone)]
-pub struct Runtime<'pa, 'ps, 'pc> {
-    assembly: &'pa [u8],
-    strings: &'ps [&'ps str],
-    charsets: &'pc [[u16; 16]],
-    entrypoint: u32,
-    stack: Vec<u32>,
-    registers: Registers,
-}
