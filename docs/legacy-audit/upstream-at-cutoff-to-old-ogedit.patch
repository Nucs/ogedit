-    }
-
-    fn peek(&self) -> Option<char> {
-        if self.pos < self.bytes.len() { Some(self.bytes[self.pos] as char) } else { None }
-    }
-
-    fn advance(&mut self, num: usize) {
-        self.pos += num;
-    }
-
-    #[cold]
-    fn fail(&self, pos: usize, kind: ParseErrorKind) -> ParseError {
