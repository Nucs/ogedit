-            | Instruction::JumpNE { lhs, rhs, tgt }
-            | Instruction::JumpLT { lhs, rhs, tgt }
-            | Instruction::JumpLE { lhs, rhs, tgt }
-            | Instruction::JumpGT { lhs, rhs, tgt }
