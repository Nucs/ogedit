-#[derive(Clone, PartialEq, Eq)]
-pub struct Highlight<T> {
-    /// Byte offset where this highlight begins.
-    pub start: usize,
-    /// The token/highlight type (e.g., keyword, string, comment).
-    pub kind: T,
-}
