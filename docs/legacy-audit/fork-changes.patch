+        while offset + pattern_len <= text_len && self.matches.len() < SELECTION_HIGHLIGHT_MAX_MATCHES {
+            // Read a chunk from the buffer
+            let chunk = buffer.read_forward(offset);
+            if chunk.is_empty() {
