diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..017e0a1
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,727 @@
+# GitHub Actions workflow for building and releasing OGEdit
+#
+# Triggers:
+# - Tags matching 'release/v*' (e.g., release/v1.2.1)
+# - Tags are auto-created by version-tag.yml when Cargo.toml version changes
+#
+# Publishing a release (automatic):
+# 1. Update version in Cargo.toml
+# 2. Commit and push to main
+# 3. version-tag.yml auto-creates the release tag
+# 4. This workflow builds and publishes the release
+#
+# Publishing a release (manual):
+# 1. git tag release/v1.2.1
+# 2. git push origin release/v1.2.1
+#
+# Build Outputs:
+# Windows:
+#   - ogedit-windows-x64.zip / .msi
+#   - ogedit-windows-arm64.zip / .msi
+# Linux:
+#   - ogedit-linux-x64.tar.xz / .tar.gz / .zip (portable)
+#   - ogedit-linux-x64.deb (Debian/Ubuntu)
+#   - ogedit-linux-x64.rpm (Fedora/RHEL)
+#   - ogedit-linux-x64.AppImage (Universal)
+# macOS:
+#   - ogedit-macos-x64.tar.gz / .zip / .pkg
+#   - ogedit-macos-arm64.tar.gz / .zip / .pkg
+# - SHA256 checksums for each
+
+name: Release
+
+on:
+  push:
+    tags:
+      - "release/v*"
+
+permissions:
+  contents: write
+
+env:
+  CARGO_TERM_COLOR: always
+
+jobs:
+  build:
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: windows-latest
+            target: x86_64-pc-windows-msvc
+            artifact: ogedit-windows-x64
+            binary: ogedit.exe
+            arch: x64
+          - os: windows-latest
+            target: aarch64-pc-windows-msvc
+            artifact: ogedit-windows-arm64
+            binary: ogedit.exe
+            arch: arm64
+          - os: ubuntu-latest
+            target: x86_64-unknown-linux-gnu
+            artifact: ogedit-linux-x64
+            binary: ogedit
+            arch: x64
+          - os: macos-latest
+            target: x86_64-apple-darwin
+            artifact: ogedit-macos-x64
+            binary: ogedit
+            arch: x64
+          - os: macos-latest
+            target: aarch64-apple-darwin
+            artifact: ogedit-macos-arm64
+            binary: ogedit
+            arch: arm64
+
+    steps:
+      - name: Disable git autocrlf
+        run: git config --global core.autocrlf false
+        if: matrix.os == 'windows-latest'
+
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Install Rust
+        run: |
+          rustup toolchain install nightly --no-self-update --profile minimal --component rust-src
+          rustup target add ${{ matrix.target }}
+
+      - name: Build release
+        run: cargo build --config .cargo/release-nightly.toml --release --target ${{ matrix.target }}
+
+      - name: Create artifact directory
+        shell: bash
+        run: mkdir -p artifact
+
+      - name: Copy binary to artifact
+        shell: bash
+        run: |
+          cp target/${{ matrix.target }}/release/${{ matrix.binary }} artifact/
+          # Also create alternative binary name
+          cp target/${{ matrix.target }}/release/${{ matrix.binary }} artifact/ogmsedit${{ matrix.os == 'windows-latest' && '.exe' || '' }}
+
+      - name: Copy license and readme
+        shell: bash
+        run: |
+          cp README.md artifact/
+          cp LICENSE artifact/ 2>/dev/null || echo "No LICENSE file"
+
+      - name: Get version from Cargo.toml
+        id: get_version
+        shell: bash
+        run: |
+          # Use Cargo.toml as single source of truth for version
+          VERSION=$(grep '^version = ' Cargo.toml | head -1 | sed 's/version = "\(.*\)"/\1/')
+          # Strip any prerelease suffix for package versions (e.g., 1.2.2-beta.1 -> 1.2.2)
+          VERSION_CLEAN=$(echo "$VERSION" | sed 's/-.*$//')
+          echo "VERSION=$VERSION" >> $GITHUB_OUTPUT
+          echo "VERSION_CLEAN=$VERSION_CLEAN" >> $GITHUB_OUTPUT
+          echo "Version from Cargo.toml: $VERSION"
+
+      - name: Create zip (Unix)
+        if: matrix.os != 'windows-latest'
+        run: |
+          cd artifact
+          zip -r ../${{ matrix.artifact }}.zip ./*
+          cd ..
+          sha256sum ${{ matrix.artifact }}.zip > ${{ matrix.artifact }}.zip.sha256
+          cat ${{ matrix.artifact }}.zip.sha256
+
+      - name: Create zip (Windows)
+        if: matrix.os == 'windows-latest'
+        shell: pwsh
+        run: |
+          Compress-Archive -Path artifact/* -DestinationPath ${{ matrix.artifact }}.zip
+          $hash = (Get-FileHash -Algorithm SHA256 ${{ matrix.artifact }}.zip).Hash.ToLower()
+          "$hash  ${{ matrix.artifact }}.zip" | Out-File -Encoding utf8 ${{ matrix.artifact }}.zip.sha256
+          Get-Content ${{ matrix.artifact }}.zip.sha256
+
+      - name: Upload zip artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}
+          path: ${{ matrix.artifact }}.zip
+          retention-days: 5
+
+      - name: Upload zip checksum
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}.sha256
+          path: ${{ matrix.artifact }}.zip.sha256
+          retention-days: 5
+
+      # ===========================================
+      # macOS .pkg Installer (with optional EDITOR env var)
+      # ===========================================
+      - name: Build macOS .pkg installer
+        if: matrix.os == 'macos-latest'
+        run: |
+          VERSION="${{ steps.get_version.outputs.VERSION_CLEAN }}"
+          ARCH="${{ matrix.arch }}"
+
+          # Create package root structure for core component
+          mkdir -p pkg-root-core/usr/local/bin
+          cp target/${{ matrix.target }}/release/${{ matrix.binary }} pkg-root-core/usr/local/bin/ogedit
+          cp target/${{ matrix.target }}/release/${{ matrix.binary }} pkg-root-core/usr/local/bin/ogmsedit
+          chmod 755 pkg-root-core/usr/local/bin/*
+
+          # Build the core component package
+          pkgbuild \
+            --root pkg-root-core \
+            --identifier com.nucs.ogedit.core \
+            --version "$VERSION" \
+            --install-location / \
+            ogedit-core-${ARCH}.pkg
+
+          # Create package structure for EDITOR env var component
+          mkdir -p pkg-root-editor-env/tmp
+          mkdir -p pkg-scripts
+          cp pkg/postinstall-editor-env pkg-scripts/postinstall
+          chmod 755 pkg-scripts/postinstall
+
+          # Build the EDITOR env var component package
+          pkgbuild \
+            --root pkg-root-editor-env \
+            --identifier com.nucs.ogedit.editor-env \
+            --version "$VERSION" \
+            --install-location / \
+            --scripts pkg-scripts \
+            ogedit-editor-env.pkg
+
+          # Prepare resources directory
+          mkdir -p pkg-resources
+          cp pkg/welcome.html pkg-resources/
+          cp pkg/license.html pkg-resources/
+          cp pkg/conclusion.html pkg-resources/
+
+          # Generate Distribution.xml from template
+          sed -e "s/__VERSION__/${VERSION}/g" \
+              -e "s/__ARCH__/${ARCH}/g" \
+              pkg/Distribution.xml.template > Distribution.xml
+
+          # Build the final product package with productbuild
+          productbuild \
+            --distribution Distribution.xml \
+            --resources pkg-resources \
+            --package-path . \
+            ${{ matrix.artifact }}.pkg
+
+          # Generate checksum
+          shasum -a 256 ${{ matrix.artifact }}.pkg > ${{ matrix.artifact }}.pkg.sha256
+          cat ${{ matrix.artifact }}.pkg.sha256
+
+      - name: Upload macOS .pkg artifact
+        if: matrix.os == 'macos-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}-pkg
+          path: ${{ matrix.artifact }}.pkg
+          retention-days: 5
+
+      - name: Upload macOS .pkg checksum
+        if: matrix.os == 'macos-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}.pkg.sha256
+          path: ${{ matrix.artifact }}.pkg.sha256
+          retention-days: 5
+
+      - name: Create macOS .tar.gz
+        if: matrix.os == 'macos-latest'
+        run: |
+          cd artifact
+          tar -czvf ../${{ matrix.artifact }}.tar.gz ./*
+          cd ..
+          shasum -a 256 ${{ matrix.artifact }}.tar.gz > ${{ matrix.artifact }}.tar.gz.sha256
+          cat ${{ matrix.artifact }}.tar.gz.sha256
+
+      - name: Upload macOS .tar.gz artifact
+        if: matrix.os == 'macos-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}-tar
+          path: ${{ matrix.artifact }}.tar.gz
+          retention-days: 5
+
+      - name: Upload macOS .tar.gz checksum
+        if: matrix.os == 'macos-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}.tar.gz.sha256
+          path: ${{ matrix.artifact }}.tar.gz.sha256
+          retention-days: 5
+
+      # ===========================================
+      # Linux Packages (.tar.gz, .tar.xz, .deb, .rpm, .AppImage)
+      # ===========================================
+      - name: Create Linux .tar.gz
+        if: matrix.os == 'ubuntu-latest'
+        run: |
+          cd artifact
+          tar -czvf ../${{ matrix.artifact }}.tar.gz ./*
+          cd ..
+          sha256sum ${{ matrix.artifact }}.tar.gz > ${{ matrix.artifact }}.tar.gz.sha256
+          cat ${{ matrix.artifact }}.tar.gz.sha256
+
+      - name: Upload Linux .tar.gz artifact
+        if: matrix.os == 'ubuntu-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}-tar
+          path: ${{ matrix.artifact }}.tar.gz
+          retention-days: 5
+
+      - name: Upload Linux .tar.gz checksum
+        if: matrix.os == 'ubuntu-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}.tar.gz.sha256
+          path: ${{ matrix.artifact }}.tar.gz.sha256
+          retention-days: 5
+
+      - name: Create Linux .tar.xz
+        if: matrix.os == 'ubuntu-latest'
+        run: |
+          cd artifact
+          tar -cJvf ../${{ matrix.artifact }}.tar.xz ./*
+          cd ..
+          sha256sum ${{ matrix.artifact }}.tar.xz > ${{ matrix.artifact }}.tar.xz.sha256
+          cat ${{ matrix.artifact }}.tar.xz.sha256
+
+      - name: Upload Linux .tar.xz artifact
+        if: matrix.os == 'ubuntu-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}-tarxz
+          path: ${{ matrix.artifact }}.tar.xz
+          retention-days: 5
+
+      - name: Upload Linux .tar.xz checksum
+        if: matrix.os == 'ubuntu-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}.tar.xz.sha256
+          path: ${{ matrix.artifact }}.tar.xz.sha256
+          retention-days: 5
+
+      - name: Build Linux .deb package
+        if: matrix.os == 'ubuntu-latest'
+        run: |
+          VERSION="${{ steps.get_version.outputs.VERSION_CLEAN }}"
+          PKG_NAME="ogedit"
+
+          # Create .deb directory structure
+          mkdir -p deb-root/DEBIAN
+          mkdir -p deb-root/usr/bin
+          mkdir -p deb-root/usr/share/doc/ogedit
+
+          # Copy binaries
+          cp target/${{ matrix.target }}/release/${{ matrix.binary }} deb-root/usr/bin/ogedit
+          cp target/${{ matrix.target }}/release/${{ matrix.binary }} deb-root/usr/bin/ogmsedit
+          chmod 755 deb-root/usr/bin/*
+
+          # Copy docs
+          cp README.md deb-root/usr/share/doc/ogedit/
+          cp LICENSE deb-root/usr/share/doc/ogedit/ 2>/dev/null || true
+
+          # Create control file with debconf dependency
+          cat > deb-root/DEBIAN/control << EOF
+          Package: ogedit
+          Version: ${VERSION}
+          Section: editors
+          Priority: optional
+          Architecture: amd64
+          Depends: debconf (>= 0.5) | debconf-2.0
+          Maintainer: Nucs <nucs@users.noreply.github.com>
+          Homepage: https://github.com/Nucs/ogedit
+          Description: Terminal-based text editor inspired by MS-DOS Editor
+           OGEdit is a fast, lightweight terminal text editor built in Rust.
+           It features SIMD-optimized operations, handles large files efficiently,
+           and provides a nostalgic MS-DOS Editor experience.
+           .
+           During installation, you can optionally set the EDITOR environment
+           variable to ogedit for all users.
+          EOF
+
+          # Copy debconf templates and scripts
+          cp deb/templates deb-root/DEBIAN/
+          cp deb/config deb-root/DEBIAN/
+          cp deb/postinst deb-root/DEBIAN/
+          cp deb/postrm deb-root/DEBIAN/
+          chmod 755 deb-root/DEBIAN/config deb-root/DEBIAN/postinst deb-root/DEBIAN/postrm
+
+          # Build .deb
+          dpkg-deb --build deb-root ${{ matrix.artifact }}.deb
+
+          # Generate checksum
+          sha256sum ${{ matrix.artifact }}.deb > ${{ matrix.artifact }}.deb.sha256
+          cat ${{ matrix.artifact }}.deb.sha256
+
+      - name: Upload Linux .deb artifact
+        if: matrix.os == 'ubuntu-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}-deb
+          path: ${{ matrix.artifact }}.deb
+          retention-days: 5
+
+      - name: Upload Linux .deb checksum
+        if: matrix.os == 'ubuntu-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}.deb.sha256
+          path: ${{ matrix.artifact }}.deb.sha256
+          retention-days: 5
+
+      - name: Build Linux .rpm package
+        if: matrix.os == 'ubuntu-latest'
+        run: |
+          VERSION="${{ steps.get_version.outputs.VERSION_CLEAN }}"
+
+          # Install rpm tools
+          sudo apt-get update
+          sudo apt-get install -y rpm
+
+          # Create RPM build structure
+          mkdir -p rpmbuild/{BUILD,RPMS,SOURCES,SPECS,SRPMS}
+          mkdir -p rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/usr/bin
+          mkdir -p rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/usr/share/doc/ogedit
+          mkdir -p rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/etc/profile.d
+
+          # Copy binaries
+          cp target/${{ matrix.target }}/release/${{ matrix.binary }} rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/usr/bin/ogedit
+          cp target/${{ matrix.target }}/release/${{ matrix.binary }} rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/usr/bin/ogmsedit
+          chmod 755 rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/usr/bin/ogedit
+          chmod 755 rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/usr/bin/ogmsedit
+
+          # Copy helper script for EDITOR configuration
+          cp rpm/ogedit-set-editor rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/usr/bin/
+          chmod 755 rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/usr/bin/ogedit-set-editor
+
+          # Copy sample profile.d script (disabled by default)
+          cp rpm/ogedit-editor.sh.sample rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/etc/profile.d/
+          chmod 644 rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/etc/profile.d/ogedit-editor.sh.sample
+
+          # Copy docs
+          cp README.md rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/usr/share/doc/ogedit/
+          cp LICENSE rpmbuild/BUILDROOT/ogedit-${VERSION}-1.x86_64/usr/share/doc/ogedit/ 2>/dev/null || true
+
+          # Create spec file
+          cat > rpmbuild/SPECS/ogedit.spec << EOF
+          Name:           ogedit
+          Version:        ${VERSION}
+          Release:        1
+          Summary:        Terminal-based text editor inspired by MS-DOS Editor
+          License:        MIT
+          URL:            https://github.com/Nucs/ogedit
+
+          %description
+          OGEdit is a fast, lightweight terminal text editor built in Rust.
+          It features SIMD-optimized operations, handles large files efficiently,
+          and provides a nostalgic MS-DOS Editor experience.
+
+          To set ogedit as the default EDITOR for all users, run:
+            sudo ogedit-set-editor --enable
+
+          %files
+          /usr/bin/ogedit
+          /usr/bin/ogmsedit
+          /usr/bin/ogedit-set-editor
+          %config(noreplace) /etc/profile.d/ogedit-editor.sh.sample
+          /usr/share/doc/ogedit/README.md
+          %doc /usr/share/doc/ogedit/
+
+          %post
+          echo ""
+          echo "To set ogedit as the default EDITOR, run:"
+          echo "  sudo ogedit-set-editor --enable"
+          echo ""
+
+          %changelog
+          * $(date '+%a %b %d %Y') Nucs <nucs@users.noreply.github.com> - ${VERSION}-1
+          - Release ${VERSION}
+          EOF
+
+          # Build RPM
+          rpmbuild --define "_topdir $(pwd)/rpmbuild" -bb rpmbuild/SPECS/ogedit.spec
+
+          # Move and rename
+          mv rpmbuild/RPMS/x86_64/ogedit-${VERSION}-1.x86_64.rpm ${{ matrix.artifact }}.rpm
+
+          # Generate checksum
+          sha256sum ${{ matrix.artifact }}.rpm > ${{ matrix.artifact }}.rpm.sha256
+          cat ${{ matrix.artifact }}.rpm.sha256
+
+      - name: Upload Linux .rpm artifact
+        if: matrix.os == 'ubuntu-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}-rpm
+          path: ${{ matrix.artifact }}.rpm
+          retention-days: 5
+
+      - name: Upload Linux .rpm checksum
+        if: matrix.os == 'ubuntu-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}.rpm.sha256
+          path: ${{ matrix.artifact }}.rpm.sha256
+          retention-days: 5
+
+      - name: Build Linux .AppImage
+        if: matrix.os == 'ubuntu-latest'
+        run: |
+          VERSION="${{ steps.get_version.outputs.VERSION }}"
+
+          # Download appimagetool and extract it (avoids FUSE requirement on CI)
+          wget -q https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage
+          chmod +x appimagetool-x86_64.AppImage
+          ./appimagetool-x86_64.AppImage --appimage-extract
+          mv squashfs-root appimagetool
+
+          # Create AppDir structure
+          mkdir -p AppDir/usr/bin
+          mkdir -p AppDir/usr/share/applications
+          mkdir -p AppDir/usr/share/icons/hicolor/256x256/apps
+
+          # Copy binary
+          cp target/${{ matrix.target }}/release/${{ matrix.binary }} AppDir/usr/bin/ogedit
+          cp target/${{ matrix.target }}/release/${{ matrix.binary }} AppDir/usr/bin/ogmsedit
+          chmod 755 AppDir/usr/bin/*
+
+          # Create desktop file
+          cat > AppDir/ogedit.desktop << EOF
+          [Desktop Entry]
+          Type=Application
+          Name=OGEdit
+          Exec=ogedit
+          Icon=ogedit
+          Comment=Terminal-based text editor inspired by MS-DOS Editor
+          Categories=Utility;TextEditor;
+          Terminal=true
+          EOF
+          cp AppDir/ogedit.desktop AppDir/usr/share/applications/
+
+          # Create a simple icon (or copy if exists)
+          if [ -f assets/edit.ico ]; then
+            # Convert ico to png if possible, or create placeholder
+            convert assets/edit.ico -resize 256x256 AppDir/ogedit.png 2>/dev/null || \
+            convert -size 256x256 xc:navy -fill white -gravity center -pointsize 48 -annotate 0 "OG" AppDir/ogedit.png 2>/dev/null || \
+            echo "" | base64 -d > AppDir/ogedit.png
+          else
+            # Create simple placeholder icon
+            convert -size 256x256 xc:navy -fill white -gravity center -pointsize 48 -annotate 0 "OG" AppDir/ogedit.png 2>/dev/null || \
+            echo "" | base64 -d > AppDir/ogedit.png
+          fi
+          cp AppDir/ogedit.png AppDir/usr/share/icons/hicolor/256x256/apps/
+
+          # Create AppRun
+          cat > AppDir/AppRun << 'EOF'
+          #!/bin/bash
+          SELF=$(readlink -f "$0")
+          HERE=${SELF%/*}
+          export PATH="${HERE}/usr/bin:${PATH}"
+          exec "${HERE}/usr/bin/ogedit" "$@"
+          EOF
+          chmod +x AppDir/AppRun
+
+          # Build AppImage using extracted appimagetool (no FUSE needed)
+          ARCH=x86_64 ./appimagetool/AppRun AppDir ${{ matrix.artifact }}.AppImage
+
+          # Generate checksum
+          sha256sum ${{ matrix.artifact }}.AppImage > ${{ matrix.artifact }}.AppImage.sha256
+          cat ${{ matrix.artifact }}.AppImage.sha256
+
+      - name: Upload Linux .AppImage artifact
+        if: matrix.os == 'ubuntu-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}-appimage
+          path: ${{ matrix.artifact }}.AppImage
+          retention-days: 5
+
+      - name: Upload Linux .AppImage checksum
+        if: matrix.os == 'ubuntu-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}.AppImage.sha256
+          path: ${{ matrix.artifact }}.AppImage.sha256
+          retention-days: 5
+
+      # ===========================================
+      # Windows MSI Installer
+      # ===========================================
+      - name: Install WiX Toolset
+        if: matrix.os == 'windows-latest'
+        shell: pwsh
+        run: |
+          dotnet tool install --global wix --version 5.0.2
+          wix extension add -g WixToolset.UI.wixext/5.0.2
+
+      - name: Build MSI
+        if: matrix.os == 'windows-latest'
+        shell: pwsh
+        run: |
+          $version = "${{ steps.get_version.outputs.VERSION_CLEAN }}"
+          $binaryPath = "target/${{ matrix.target }}/release"
+          $assetPath = "assets"
+
+          wix build wix/main.wxs `
+            -arch ${{ matrix.arch }} `
+            -d Version=$version `
+            -d BinaryPath=$binaryPath `
+            -d AssetPath=$assetPath `
+            -ext WixToolset.UI.wixext `
+            -o ${{ matrix.artifact }}.msi
+
+          # Generate checksum
+          $hash = (Get-FileHash -Algorithm SHA256 ${{ matrix.artifact }}.msi).Hash.ToLower()
+          "$hash  ${{ matrix.artifact }}.msi" | Out-File -Encoding utf8 ${{ matrix.artifact }}.msi.sha256
+          Get-Content ${{ matrix.artifact }}.msi.sha256
+
+      - name: Upload MSI artifact
+        if: matrix.os == 'windows-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}-msi
+          path: ${{ matrix.artifact }}.msi
+          retention-days: 5
+
+      - name: Upload MSI checksum
+        if: matrix.os == 'windows-latest'
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact }}.msi.sha256
+          path: ${{ matrix.artifact }}.msi.sha256
+          retention-days: 5
+
+  create-release:
+    needs: build
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Download all artifacts
+        uses: actions/download-artifact@v4
+        with:
+          pattern: ogedit-*
+          merge-multiple: true
+
+      - name: List artifacts
+        run: ls -la
+
+      - name: Get version from Cargo.toml
+        id: get_version
+        run: |
+          # Use Cargo.toml as single source of truth for version
+          VERSION=$(grep '^version = ' Cargo.toml | head -1 | sed 's/version = "\(.*\)"/\1/')
+          echo "VERSION=$VERSION" >> $GITHUB_OUTPUT
+          echo "Version from Cargo.toml: $VERSION"
+
+      - name: Check if prerelease
+        id: check_prerelease
+        run: |
+          VERSION="${{ steps.get_version.outputs.VERSION }}"
+          if [[ "$VERSION" =~ (-alpha|-beta|-rc) ]]; then
+            echo "IS_PRERELEASE=true" >> $GITHUB_OUTPUT
+            echo "Detected prerelease version: $VERSION"
+          else
+            echo "IS_PRERELEASE=false" >> $GITHUB_OUTPUT
+          fi
+
+      - name: Generate release notes
+        id: release_notes
+        run: |
+          echo "NOTES<<EOF" >> $GITHUB_OUTPUT
+          echo "## OGEdit v${{ steps.get_version.outputs.VERSION }}" >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "### Downloads" >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "#### Windows" >> $GITHUB_OUTPUT
+          echo "| Architecture | Installer (adds to PATH) | Portable |" >> $GITHUB_OUTPUT
+          echo "|--------------|--------------------------|----------|" >> $GITHUB_OUTPUT
+          echo "| x64 | \`ogedit-windows-x64.msi\` | \`ogedit-windows-x64.zip\` |" >> $GITHUB_OUTPUT
+          echo "| ARM64 | \`ogedit-windows-arm64.msi\` | \`ogedit-windows-arm64.zip\` |" >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "#### macOS" >> $GITHUB_OUTPUT
+          echo "| Architecture | Installer (adds to PATH) | Portable |" >> $GITHUB_OUTPUT
+          echo "|--------------|--------------------------|----------|" >> $GITHUB_OUTPUT
+          echo "| x64 (Intel) | \`ogedit-macos-x64.pkg\` | \`.tar.gz\` / \`.zip\` |" >> $GITHUB_OUTPUT
+          echo "| ARM64 (Apple Silicon) | \`ogedit-macos-arm64.pkg\` | \`.tar.gz\` / \`.zip\` |" >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "#### Linux" >> $GITHUB_OUTPUT
+          echo "| Format | File | Description |" >> $GITHUB_OUTPUT
+          echo "|--------|------|-------------|" >> $GITHUB_OUTPUT
+          echo "| Debian/Ubuntu | \`ogedit-linux-x64.deb\` | \`sudo dpkg -i ogedit-linux-x64.deb\` |" >> $GITHUB_OUTPUT
+          echo "| Fedora/RHEL | \`ogedit-linux-x64.rpm\` | \`sudo rpm -i ogedit-linux-x64.rpm\` |" >> $GITHUB_OUTPUT
+          echo "| AppImage | \`ogedit-linux-x64.AppImage\` | Universal, run directly |" >> $GITHUB_OUTPUT
+          echo "| Portable | \`ogedit-linux-x64.tar.xz\` | Best compression |" >> $GITHUB_OUTPUT
+          echo "| Portable | \`ogedit-linux-x64.tar.gz\` | Standard Unix archive |" >> $GITHUB_OUTPUT
+          echo "| Portable | \`ogedit-linux-x64.zip\` | Cross-platform |" >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "### Verification" >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "SHA256 checksums are provided for each download (\`.sha256\` files)." >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "### Installation" >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "**Windows:** Run the \`.msi\` installer. OGEdit will be added to PATH." >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "**macOS:** Run the \`.pkg\` installer. Installs to \`/usr/local/bin\` (already on PATH)." >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "**Linux (Debian/Ubuntu):**" >> $GITHUB_OUTPUT
+          echo "\`\`\`bash" >> $GITHUB_OUTPUT
+          echo "sudo dpkg -i ogedit-linux-x64.deb" >> $GITHUB_OUTPUT
+          echo "\`\`\`" >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "**Linux (Fedora/RHEL):**" >> $GITHUB_OUTPUT
+          echo "\`\`\`bash" >> $GITHUB_OUTPUT
+          echo "sudo rpm -i ogedit-linux-x64.rpm" >> $GITHUB_OUTPUT
+          echo "\`\`\`" >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "**Linux (AppImage):**" >> $GITHUB_OUTPUT
+          echo "\`\`\`bash" >> $GITHUB_OUTPUT
+          echo "chmod +x ogedit-linux-x64.AppImage" >> $GITHUB_OUTPUT
+          echo "./ogedit-linux-x64.AppImage" >> $GITHUB_OUTPUT
+          echo "\`\`\`" >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "**Portable (all platforms):** Extract and add the directory to your PATH." >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "### Optional: Set as Default EDITOR" >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "All installers offer an option to set the \`EDITOR\` environment variable to \`ogedit\`. This variable is used by git, crontab, and many other tools." >> $GITHUB_OUTPUT
+          echo "" >> $GITHUB_OUTPUT
+          echo "- **Windows MSI:** Select \"Set as EDITOR\" in the feature tree during installation" >> $GITHUB_OUTPUT
+          echo "- **macOS PKG:** Check \"Set as EDITOR\" in the Customize menu during installation" >> $GITHUB_OUTPUT
+          echo "- **Linux DEB:** Answer \"Yes\" when prompted during installation" >> $GITHUB_OUTPUT
+          echo "- **Linux RPM:** Run \\\`sudo ogedit-set-editor --enable\\\` after installation" >> $GITHUB_OUTPUT
+          echo "EOF" >> $GITHUB_OUTPUT
+
+      - name: Create release
+        uses: softprops/action-gh-release@v1
+        with:
+          name: v${{ steps.get_version.outputs.VERSION }}
+          body: ${{ steps.release_notes.outputs.NOTES }}
+          draft: false
+          prerelease: ${{ steps.check_prerelease.outputs.IS_PRERELEASE }}
+          files: |
+            ogedit-*.zip
+            ogedit-*.zip.sha256
+            ogedit-*.msi
+            ogedit-*.msi.sha256
+            ogedit-*.pkg
+            ogedit-*.pkg.sha256
+            ogedit-*.tar.gz
+            ogedit-*.tar.gz.sha256
+            ogedit-*.tar.xz
+            ogedit-*.tar.xz.sha256
+            ogedit-*.deb
+            ogedit-*.deb.sha256
+            ogedit-*.rpm
+            ogedit-*.rpm.sha256
+            ogedit-*.AppImage
+            ogedit-*.AppImage.sha256
diff --git a/.github/workflows/version-tag.yml b/.github/workflows/version-tag.yml
new file mode 100644
index 0000000..efef5ac
--- /dev/null
+++ b/.github/workflows/version-tag.yml
@@ -0,0 +1,72 @@
+# Auto-create release tag when Cargo.toml version changes
+#
+# Workflow:
+# 1. Developer updates version in Cargo.toml
+# 2. Developer pushes to main
+# 3. This workflow detects the change and creates release/vX.Y.Z tag
+# 4. The tag triggers release.yml which builds all platforms
+#
+# Manual tagging still works - this just automates it
+#
+# Examples:
+#   Cargo.toml: version = "1.2.5"     -> creates tag: release/v1.2.5
+#   Cargo.toml: version = "1.3.0-beta.1" -> creates tag: release/v1.3.0-beta.1
+
+name: Auto-tag Release
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - 'Cargo.toml'
+
+# Prevent duplicate runs if someone pushes commit + tag together
+concurrency:
+  group: release-${{ github.sha }}
+  cancel-in-progress: false
+
+jobs:
+  create-tag:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0 # Need full history for tag operations
+
+      - name: Extract version from Cargo.toml
+        id: version
+        run: |
+          VERSION=$(grep '^version = ' Cargo.toml | head -1 | sed 's/version = "\(.*\)"/\1/')
+          echo "VERSION=$VERSION" >> $GITHUB_OUTPUT
+          echo "Detected version: $VERSION"
+
+      - name: Check if tag already exists
+        id: check_tag
+        run: |
+          TAG="release/v${{ steps.version.outputs.VERSION }}"
+          if git rev-parse "$TAG" >/dev/null 2>&1; then
+            echo "EXISTS=true" >> $GITHUB_OUTPUT
+            echo "Tag $TAG already exists"
+          else
+            echo "EXISTS=false" >> $GITHUB_OUTPUT
+            echo "Tag $TAG does not exist"
+          fi
+
+      - name: Create and push tag
+        if: steps.check_tag.outputs.EXISTS == 'false'
+        run: |
+          TAG="release/v${{ steps.version.outputs.VERSION }}"
+          git config user.name "github-actions[bot]"
+          git config user.email "github-actions[bot]@users.noreply.github.com"
+          git tag "$TAG" -m "Release v${{ steps.version.outputs.VERSION }}"
+
+          # Push tag (may fail if someone manually pushed it in a race condition - that's OK)
+          if git push origin "$TAG" 2>&1; then
+            echo "✅ Created and pushed tag: $TAG"
+          else
+            echo "⚠️ Tag $TAG already exists on remote (likely manual push) - skipping"
+          fi
