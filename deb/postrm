#!/bin/sh
# Post-removal script for ogedit
set -e

PROFILE_FILE="/etc/profile.d/ogedit-editor.sh"

remove_editor_profile() {
    # Do not remove a replacement created by the administrator.
    if [ -f "$PROFILE_FILE" ] && [ ! -L "$PROFILE_FILE" ] &&
       [ "$(cat "$PROFILE_FILE")" = "$(printf '%s\n' '# Set EDITOR to ogedit (installed by ogedit package)' 'export EDITOR="/usr/bin/ogedit"')" ]; then
        rm -f "$PROFILE_FILE"
    fi
}

case "$1" in
    purge)
        # Remove profile.d script and debconf data
        remove_editor_profile
        if [ -e /usr/share/debconf/confmodule ]; then
            . /usr/share/debconf/confmodule
            db_purge
        fi
        ;;

    remove|disappear)
        # A normal uninstall must not leave EDITOR pointing at a missing binary.
        remove_editor_profile
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
