#!/bin/bash
# The optional component runs as root. All shell-profile writes run as the
# console user, so symlinks or a changed home directory cannot grant root writes.
set -euo pipefail

CONSOLE_USER=$(/usr/bin/stat -f '%Su' /dev/console)
case "$CONSOLE_USER" in
    ''|root|loginwindow|_mbsetupuser)
        echo 'No interactive user found. Set EDITOR=/usr/local/bin/ogedit in your shell profile manually.'
        exit 0
        ;;
esac

USER_ID=$(/usr/bin/id -u "$CONSOLE_USER")
if [ "$USER_ID" -eq 0 ]; then
    echo 'Refusing to modify the root shell profile.' >&2
    exit 1
fi
USER_HOME=$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory | /usr/bin/sed 's/^NFSHomeDirectory: //')
case "$USER_HOME" in
    /*) ;;
    *) echo 'Could not determine the console user home directory.' >&2; exit 1 ;;
esac

/usr/bin/sudo -u "$CONSOLE_USER" -H -- /bin/sh -s -- "$USER_HOME" <<'OGEDIT_USER_SCRIPT'
set -eu
user_home=$1
if [ -f "$user_home/.zshrc" ]; then
    shell_rc="$user_home/.zshrc"
elif [ -f "$user_home/.bash_profile" ]; then
    shell_rc="$user_home/.bash_profile"
elif [ -f "$user_home/.bashrc" ]; then
    shell_rc="$user_home/.bashrc"
else
    shell_rc="$user_home/.zshrc"
fi
if grep -Fqx 'export EDITOR="/usr/local/bin/ogedit"' "$shell_rc" 2>/dev/null; then
    echo "EDITOR already set to ogedit in $shell_rc"
    exit 0
fi
printf '\n# Set by OGEdit installer\nexport EDITOR="/usr/local/bin/ogedit"\n' >> "$shell_rc"
echo "EDITOR set to ogedit in $shell_rc"
OGEDIT_USER_SCRIPT
